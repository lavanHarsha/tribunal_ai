# TRIBUNAL — server-side environment variables
# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Required. Your Gemini API key (server-side only — never exposed to the browser).
GEMINI_API_KEY


# Optional. Model used for all agents and the Judge.
# Defaults to gemini-3.6-flash when unset.
GEMINI_MODEL
