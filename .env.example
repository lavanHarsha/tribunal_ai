# TRIBUNAL — server-side environment variables
# Copy this file to .env.local and fill in your values. Never commit .env.local.
#
# WHERE TO EDIT YOUR KEY: this file's real counterpart is `.env.local` (git-ignored).
# Set GEMINI_API_KEY there, then RESTART the dev server (env is read at startup).
# The value is consumed by lib/ai/config.ts -> getApiKey(). It is server-side only
# and is never sent to the browser.
#
# WHICH GOOGLE API HAS THE HIGHER FREE TIER?
#   Use a "Gemini API" key from Google AI Studio  ->  https://aistudio.google.com/app/apikey
#   This is the generous free tier (rate-limited free requests per minute/day).
#   Vertex AI (Google Cloud) has NO standing free tier for Gemini — it is pay-as-you-go
#   and needs a billing account, so avoid it unless you specifically want Cloud.
#   End users can also supply their own key at runtime via Settings -> BYOK, in which
#   case their usage bills to their own Google account (see lib/byok.ts).

# Required for Default Mode (unless visitors supply a Gemini key via BYOK).
# Groq API Key (used for Advocate & Auditor agents) -> https://console.groq.com
GROQ_API_KEY=
# Optional. Groq model (defaults to openai/gpt-oss-120b)
GROQ_MODEL=

# NVIDIA NIM API Key (used for Critic agent) -> https://build.nvidia.com
NVIDIA_API_KEY=
# Optional. NVIDIA NIM model (defaults to nemotron-3-super-120b-a12b)
NVIDIA_MODEL=

# Gemini API Key (used for Judge agent in Default Mode & BYOK) -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional. Gemini model (defaults to gemini-2.5-flash)
GEMINI_MODEL=

